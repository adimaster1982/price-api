# --- חובה ---
ANTHROPIC_API_KEY=            # מפתח Claude API (console.anthropic.com)
DASHBOARD_PASS=               # סיסמה ללוח הבקרה (משתמש: admin)
DOMAIN=                       # כתובת ללוח הבקרה, למשל 203.0.113.10.sslip.io או maint.example.co.il

# --- אופציונלי ---
DASHBOARD_USER=admin
MANAGER_PHONES=9725XXXXXXXX   # מספרים להסלמה, מופרדים בפסיק, בפורמט בינלאומי
GROUP_ID=                     # לא חובה – אפשר לבחור את הקבוצה בלוח הבקרה
CLAUDE_MODEL=claude-opus-5-5  # claude-haiku-5-5 זול בהרבה, פחות מדויק בעברית חופשית
URGENT_ESCALATE_HOURS=2
NORMAL_ESCALATE_HOURS=48
DAILY_SUMMARY_CRON=40 6 * * 0-5   # א'-ו' 06:40
